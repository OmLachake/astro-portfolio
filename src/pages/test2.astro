---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import projects from '../data/projects.ts';

if (import.meta.env.PROD) {
    return new Response(null, { status: 404 });
}
---

<BaseLayout pageTitle="Test — Project Showcase">
    <div class="projects-page">
        <div class="projects-header">
            <h1 class="projects-title">
                <span class="title-line">A Few Things</span><br />
                <span class="title-accent">I've Built</span>
            </h1>
        </div>
        <div class="showcase-container">
            <ProjectShowcase projects={projects} />
        </div>
    </div>
</BaseLayout>

<style lang="scss">
    .projects-page {
        padding-bottom: 6rem;
    }

    .projects-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 6rem 2.5rem 3rem;
        text-align: center;
    }

    .projects-title {
        font-family: var(--yesevaFont);
        font-size: clamp(2rem, 4vw, 3.5rem);
        color: var(--foregroundColor);
        line-height: 1.2;
        margin: 0;

        .title-accent {
            color: var(--accentColor);
        }
    }

    .showcase-container {
        margin: 0 1.5rem;
        border-radius: 1.5rem;
        overflow: clip;

        @media (max-width: 800px) {
            margin: 0 0.75rem;
            border-radius: 1rem;
        }

        @media (min-width: 1200px) {
            margin: 0 3rem;
        }

        @media (min-width: 1600px) {
            margin: 0 6rem;
        }
    }

</style>

<script>
    import gsap from 'gsap';
    import ScrollTrigger from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // Single timeline: enter (0–30%), hold (30–65%), exit (65–100%)
    gsap.timeline({
        scrollTrigger: {
            trigger: '.projects-header',
            start: 'top 85%',
            end: 'bottom -5%',
            scrub: 0.8,
        },
    })
    .fromTo('.title-line',
        { opacity: 0, y: 60 },
        { opacity: 1, y: 0, ease: 'power2.out', duration: 0.3 },
        0
    )
    .fromTo('.title-accent',
        { opacity: 0, y: 60 },
        { opacity: 1, y: 0, ease: 'power2.out', duration: 0.3 },
        0.08
    )
    .to('.title-line',
        { opacity: 0, y: -50, ease: 'power2.in', duration: 0.28 },
        0.65
    )
    .to('.title-accent',
        { opacity: 0, y: -50, ease: 'power2.in', duration: 0.28 },
        0.72
    );

    // Showcase: scrub fade-in
    gsap.fromTo('.showcase-container',
        { opacity: 0 },
        {
            opacity: 1,
            ease: 'none',
            scrollTrigger: {
                trigger: '.showcase-container',
                start: 'top 90%',
                end: 'top 50%',
                scrub: 0.6,
            },
        }
    );
</script>
