---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import projects from '../data/projects.ts';

if (import.meta.env.PROD) {
    return new Response(null, { status: 404 });
}
---

<BaseLayout pageTitle="Test — Skills Showcase">
    <section class="skills-section">
        <div class="skills-content">
            <h2>Information flows best through intentional design</h2>
        </div>

        <div class="header">
            <div class="header-content">
                <h2>Find what matters through intelligent design</h2>
                <p>
                    Discover a system that adapts to the way you think, not the
                    other way around.
                </p>
            </div>
        </div>

        <div class="features">
            <div class="feature">
                <div class="feature-bg"></div>
                <div class="feature-content">
                    <p>Flow</p>
                </div>
            </div>

            <div class="feature">
                <div class="feature-bg"></div>
                <div class="feature-content">
                    <p>Knowledge Grid</p>
                </div>
            </div>

            <div class="feature">
                <div class="feature-bg"></div>
                <div class="feature-content">
                    <p>Relay</p>
                </div>
            </div>

            <div class="feature">
                <div class="feature-bg"></div>
                <div class="feature-content">
                    <p>Adaptive Layer</p>
                </div>
            </div>

            <div class="feature">
                <div class="feature-bg"></div>
                <div class="feature-content">
                    <p>Signal</p>
                </div>
            </div>

            <div class="feature">
                <div class="feature-bg"></div>
                <div class="feature-content">
                    <p>System Design</p>
                </div>
            </div>

            <div class="feature">
                <div class="feature-bg"></div>
                <div class="feature-content">
                    <p>Archive</p>
                </div>
            </div>

            <div class="feature">
                <div class="feature-bg"></div>
                <div class="feature-content">
                    <p>Creative Design</p>
                </div>
            </div>
        </div>

        <div class="search-bar">
            <p>Find the unseen link</p>
        </div>
    </section>
</BaseLayout>

<style lang="scss">
    h2 {
        font-family: var(--soriaFont);
        text-align: center;
        font-size: 5rem;
        font-weight: 500;
        line-height: 0.9;
    }

    p {
        font-family: var(--urabnistFont);
        font-size: 1rem;
        font-weight: 500;
        line-height: 1;
    }

    .skills-section {
        position: relative;
        width: 100%;
        height: 100svh;
        overflow: hidden;
    }

    .header {
        position: absolute;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        will-change: transform;
    }

    .skills-content {
        position: absolute;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: stretch;
        will-change: transform;
        padding-top: 5rem;
    }

    .skills-bg {
        position: absolute;
        transform: scale(0.8);
        opacity: 0.25;
    }

    .skills-content h2 {
        width: 70%;
    }

    .header-content {
        width: 60%;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 2rem;
        will-change: transform, opacity;
        transform: translateY(-100px);
        opacity: 0;
    }

    .feature {
        position: absolute;
        width: max-content;
        height: max-content;
        padding: 1rem 1.5rem;
        transform: translate(-50%, -50%);
        will-change: top, left;
    }

    .feature-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        height: 100%;
        background-color: var(--accentColor);
        border: 0.125rem solid var(--foregroundColor);
        border-radius: 0.5rem;
        will-change: width, height, border-radius, border-width;
    }

    .feature-content {
        position: relative;
        will-change: opacity;
    }

    .feature-content p {
        text-transform: uppercase;
        font-family: var(--urabanistFont);
        font-weight: 600;
        font-size: 1rem;
        line-height: 1;
    }

    .search-bar {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 3rem;
        height: 3rem;
        border-radius: 25rem;
        border: 0.35rem solid var(--foregroundColor);
        background-color: var(--accentColor);
        opacity: 0;
        display: flex;
        align-items: center;
        will-change: opacity, width, height, transform;
    }

    .search-bar p {
        position: relative;
        opacity: 0;
        transform: translateX(2rem);
        will-change: opacity;
    }

    @media (max-width: 1000px) {
        h1 {
            font-size: 2.5rem;
        }

        .intro h1,
        .outro h1,
        .spotlight-content h1,
        .header-content {
            width: 100%;
            padding: 2rem;
        }

        .spotlight-bg {
            transform: scale(2);
        }

        .feature {
            padding: 1rem;
        }

        .feature-content p {
            font-size: 0.7rem;
        }
    }
</style>

<script>
    import '../scripts/hero';
</script>
