---
import BlogCard from '..//../components/Blog/BlogCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const isDev = import.meta.env.DEV;

export async function getStaticPaths() {
    const isDev = import.meta.env.DEV;

    const allPosts = Object.values(
        import.meta.glob('../blogs/*.mdx', { eager: true }),
    ) as any[];

    const visiblePosts = isDev
        ? allPosts
        : allPosts.filter((p) => p.frontmatter.published === true);

    const uniqueTags = [
        ...new Set(visiblePosts.flatMap((post: any) => post.frontmatter.tags ?? [])),
    ];

    return uniqueTags.map((tag) => ({
        params: { tag },
        props: {
            posts: visiblePosts.filter((post: any) =>
                post.frontmatter.tags?.includes(tag),
            ),
        },
    }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout pageTitle={`#${tag}`}>
    <div class="tag-page-container">
        <section class="heading">
            <div class="heading-left">
                <a href="/tags" class="back-link">← All Tags</a>
                <h2 class="page-title">#{tag}</h2>
            </div>
            <p class="page-subtitle">{posts.length} post{posts.length !== 1 ? 's' : ''}</p>
        </section>

        <section class="blog-grid">
            {posts.map((post: any) => <BlogCard post={post} />)}
        </section>
    </div>
</BaseLayout>

<style lang="scss">
    .tag-page-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        margin-top: 8rem;
        padding: 0 2rem;

        @media (max-width: 800px) {
            padding: 0 1rem 2rem;
        }
    }

    .heading {
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--backgroundDarkColor, rgba(0, 0, 0, 0.1));
        padding-bottom: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 1rem;

        .heading-left {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .back-link {
            font-family: var(--urbanistFont);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--foregroundColor);
            opacity: 0.5;
            text-decoration: none;
            transition: opacity 0.2s ease;

            &:hover {
                opacity: 1;
            }
        }

        .page-title {
            font-family: var(--newsflashFont);
            text-transform: uppercase;
            letter-spacing: 0.5rem;
            font-size: clamp(3rem, 6vw, 7rem);
            color: var(--foregroundColor);
            line-height: 1;
            opacity: 0;
            margin: 0;

            @media (max-width: 800px) {
                font-size: clamp(2.5rem, 8vw, 5rem);
            }
        }

        .page-subtitle {
            font-family: var(--urbanistFont);
            font-weight: 200;
            font-size: 1.1rem;
            color: var(--foregroundDarkColor);
            opacity: 0;
            align-self: flex-end;
        }
    }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
        width: 100%;
        gap: 1.5rem;
    }
</style>

<script>
    import '../../scripts/tags';
</script>
