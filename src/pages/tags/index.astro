---
import BaseLayout from '../../layouts/BaseLayout.astro';

const isDev = import.meta.env.DEV;

const allPosts = Object.values(
    import.meta.glob('../blogs/*.mdx', { eager: true }),
) as any[];

const visiblePosts = isDev
    ? allPosts
    : allPosts.filter((p) => p.frontmatter.published === true);

const tagCounts = visiblePosts
    .flatMap((p: any) => p.frontmatter.tags ?? [])
    .reduce((acc: Record<string, number>, tag: string) => {
        acc[tag] = (acc[tag] ?? 0) + 1;
        return acc;
    }, {});

const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout pageTitle="Tags">
    <div class="tags-page-container">
        <section class="heading">
            <h2 class="page-title">Tags</h2>
            <p class="page-subtitle">Browse posts by topic.</p>
        </section>

        {
            tags.length === 0 ? (
                <p class="empty">No tags yet — check back soon.</p>
            ) : (
                <div class="tag-cloud">
                    {tags.map(([tag, count]) => (
                        <a href={`/tags/${tag}`} class="tag-chip">
                            <span class="tag-name">{tag}</span>
                            <span class="tag-count">{count}</span>
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</BaseLayout>

<style lang="scss">
    .tags-page-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        margin-top: 8rem;
        padding: 0 2rem;

        @media (max-width: 800px) {
            padding: 0 1rem 2rem;
        }
    }

    .heading {
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--backgroundDarkColor, rgba(0, 0, 0, 0.1));
        padding-bottom: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;

        .page-title {
            font-family: var(--newsflashFont);
            text-transform: uppercase;
            letter-spacing: 1rem;
            font-size: clamp(5rem, 7vw, 10rem);
            color: var(--foregroundColor);
            line-height: 1;
            opacity: 0;

            @media (max-width: 800px) {
                width: 100%;
                text-align: center;
            }
        }

        .page-subtitle {
            font-family: var(--urbanistFont);
            font-weight: 200;
            font-size: clamp(1.3rem, 1.5vw, 5rem);
            color: var(--foregroundDarkColor);
            opacity: 0;
            margin-top: 2rem;

            @media (max-width: 800px) {
                width: 100%;
                text-align: center;
            }
        }
    }

    .tag-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 2rem 0;
    }

    .tag-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.2rem;
        border: 1px solid var(--backgroundDarkColor);
        border-radius: 2rem;
        text-decoration: none;
        font-family: var(--urbanistFont);
        opacity: 0;
        transition:
            border-color 0.25s ease,
            background 0.25s ease,
            transform 0.2s ease;

        &:hover {
            border-color: var(--accentColor);
            background: var(--backgroundDarkColor);
            transform: translateY(-2px);

            .tag-count {
                background: var(--accentColor);
                color: var(--backgroundColor);
            }
        }

        .tag-name {
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--foregroundColor);
        }

        .tag-count {
            font-size: 0.7rem;
            font-weight: 700;
            background: var(--backgroundDarkColor);
            color: var(--foregroundColor);
            border-radius: 999px;
            padding: 0.15rem 0.5rem;
            transition: background 0.25s ease, color 0.25s ease;
        }
    }

    .empty {
        font-family: var(--urbanistFont);
        opacity: 0.45;
        padding: 4rem 0;
        text-align: center;
    }
</style>

<script>
    import '../../scripts/tags';
</script>
