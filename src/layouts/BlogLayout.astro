---
import BaseLayout from './BaseLayout.astro';
import site from '../data/site';

const { frontmatter } = Astro.props;

const dateObj = new Date(frontmatter.pubDate);

const blogPostingSchema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: frontmatter.title,
    description: frontmatter.description,
    datePublished: dateObj.toISOString(),
    url: Astro.url.href,
    image: frontmatter.image?.url,
    author: {
        '@type': 'Person',
        name: site.author,
        url: Astro.site?.toString(),
    },
};
const formattedDate = dateObj.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});
---

<BaseLayout
    pageTitle={frontmatter.title}
    description={frontmatter.description}
    ogImage={frontmatter.image?.url}
    type="article"
    jsonLd={blogPostingSchema}
    showLoader={false}
>
    <!-- ──────────────── HERO ──────────────── -->
    <section class="post-hero">
        <div class="post-hero-inner">
            <a href="/blog" class="post-back">← All Posts</a>

            {
                frontmatter.tags && frontmatter.tags.length > 0 && (
                    <div class="post-tags">
                        {frontmatter.tags.map((tag: string) => (
                            <a href={`/tags/${tag}`} class="post-tag">{tag}</a>
                        ))}
                    </div>
                )
            }

            <h1 class="post-title">{frontmatter.title}</h1>

            <p class="post-description">{frontmatter.description}</p>

            <div class="post-meta">
                <span class="post-author">{frontmatter.author}</span>
                <span class="post-sep" aria-hidden="true">·</span>
                <time datetime={dateObj.toISOString()} class="post-date">
                    {formattedDate}
                </time>
            </div>
        </div>
    </section>

    <!-- ──────────────── CONTENT ──────────────── -->
    <article class="post-content">
        <slot />
    </article>

    <!-- ──────────────── BOTTOM NAV ──────────────── -->
    <div class="post-bottom-nav">
        <a href="/blog" class="back-link">← Back to all posts</a>
    </div>
</BaseLayout>

<style lang="scss">
    /* ────────────────────────────────────────
       Post Hero
    ──────────────────────────────────────── */
    .post-hero {
        width: 100%;
        padding-top: 8rem;
        background-color: var(--backgroundColor);

        @media (max-width: 800px) {
            padding-top: 6rem;
        }
    }

    .post-hero-inner {
        max-width: 860px;
        margin: 0 auto;
        padding: 0 2rem 3rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;

        @media (max-width: 800px) {
            padding: 0 1rem 2rem;
        }
    }

    .post-back {
        font-family: var(--urbanistFont);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--foregroundColor);
        opacity: 0.55;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition:
            color 0.2s ease,
            opacity 0.2s ease;
        width: fit-content;

        &:hover {
            color: var(--accentColor);
            opacity: 1;
        }
    }

    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;

        .post-tag {
            font-family: var(--urbanistFont);
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--accentColor);
            background: var(--backgroundDarkColor);
            padding: 0.25rem 0.65rem;
            border-radius: 0.4rem;
            text-decoration: none;
            transition: opacity 0.2s ease;

            &:hover {
                opacity: 0.7;
            }
        }
    }

    .post-title {
        font-family: var(--yesevaFont);
        font-size: clamp(2.2rem, 5.5vw, 4.5rem);
        line-height: 1.06;
        color: var(--foregroundColor);
        margin: 0;
    }

    .post-description {
        font-family: var(--urbanistFont);
        font-size: clamp(1rem, 1.8vw, 1.2rem);
        font-weight: 300;
        line-height: 1.65;
        color: var(--foregroundColor);
        max-width: 640px;
    }

    .post-meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--urbanistFont);
        font-size: 0.9rem;

        .post-author {
            font-weight: 700;
            color: var(--foregroundColor);
        }

        .post-sep {
            color: var(--foregroundColor);
            opacity: 0.35;
        }

        .post-date {
            color: var(--foregroundColor);
            opacity: 0.55;
        }
    }

    /* ────────────────────────────────────────
       Post Content — Prose Styles
    ──────────────────────────────────────── */
    .post-content {
        max-width: 720px;
        margin: 0 auto;
        padding: 4rem 2rem 2rem;

        @media (max-width: 800px) {
            padding: 2.5rem 1rem 1.5rem;
        }

        /*
         * h1 is hidden — post title is already in the hero.
         */
        :global(h1) {
            display: none;
        }

        /* ── Headings ── */
        :global(h2),
        :global(h3),
        :global(h4),
        :global(h5),
        :global(h6) {
            font-family: var(--yesevaFont);
            color: var(--foregroundColor);
            margin: 2.75rem 0 1rem;
            line-height: 1.15;
        }

        :global(h2) {
            font-size: clamp(1.5rem, 3vw, 2.1rem);
            padding-bottom: 0.6rem;
            border-bottom: 1px solid var(--backgroundDarkColor);
            position: relative;

            &::after {
                content: '';
                position: absolute;
                bottom: -1px;
                left: 0;
                width: 2.5rem;
                height: 2px;
                background: var(--accentColor);
            }
        }

        :global(h3) {
            font-size: clamp(1.15rem, 2.2vw, 1.65rem);
        }

        :global(h4) {
            font-size: 1.1rem;
            font-family: var(--urbanistFont);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        :global(h5),
        :global(h6) {
            font-size: 1rem;
            font-family: var(--urbanistFont);
            font-weight: 600;
        }

        /* ── Body text ── */
        :global(p) {
            font-family: var(--urbanistFont);
            font-size: 1.1rem;
            line-height: 1.78;
            color: var(--foregroundColor);
            margin: 1.3rem 0;
        }

        /* ── Links — MdxLink component handles styled variants ── */
        :global(a:not(.link-button)) {
            color: var(--accentColor);
            text-decoration: underline;
            text-decoration-color: transparent;
            text-underline-offset: 3px;
            transition: text-decoration-color 0.2s ease;

            &:hover {
                text-decoration-color: var(--accentColor);
            }
        }

        /* ── Inline emphasis ── */
        :global(strong) {
            font-weight: 700;
        }

        :global(em) {
            font-style: italic;
        }

        :global(del) {
            opacity: 0.55;
            text-decoration: line-through;
        }

        :global(ins) {
            text-decoration: underline;
            text-decoration-color: var(--accentColor);
        }

        :global(mark) {
            background: rgba(255, 220, 40, 0.3);
            color: inherit;
            padding: 0.1em 0.3em;
            border-radius: 0.2rem;
        }

        :global(sub),
        :global(sup) {
            font-size: 0.72em;
            line-height: 0;
        }

        :global(abbr[title]) {
            text-decoration: underline dotted;
            cursor: help;
        }

        :global(cite) {
            font-style: italic;
            opacity: 0.75;
        }

        /* ── Keyboard keys ── */
        :global(kbd) {
            font-family: 'Courier New', monospace;
            font-size: 0.8em;
            background: var(--backgroundDarkColor);
            border: 1px solid var(--foregroundDarkColor);
            border-bottom-width: 2px;
            padding: 0.1em 0.45em;
            border-radius: 0.3rem;
            color: var(--foregroundColor);
            white-space: nowrap;
        }

        /* ── HR ── */
        :global(hr) {
            border: none;
            border-top: 1px solid var(--backgroundDarkColor);
            margin: 2.5rem 0;
        }

        /* ── Unordered lists ── */
        :global(ul) {
            font-family: var(--urbanistFont);
            font-size: 1.1rem;
            line-height: 1.75;
            padding-left: 1.5rem;
            margin: 1.3rem 0;
            list-style: none;
            color: var(--foregroundColor);

            :global(li) {
                margin: 0.45rem 0;
                position: relative;

                &::before {
                    content: '–';
                    color: var(--accentColor);
                    position: absolute;
                    left: -1.25rem;
                    font-weight: 700;
                }
            }

            :global(ul) {
                margin: 0.2rem 0;

                :global(li)::before {
                    content: '·';
                }
            }
        }

        /* ── Ordered lists ── */
        :global(ol) {
            font-family: var(--urbanistFont);
            font-size: 1.1rem;
            line-height: 1.75;
            padding-left: 1.75rem;
            margin: 1.3rem 0;
            color: var(--foregroundColor);
            list-style: decimal;

            :global(li) {
                margin: 0.45rem 0;

                &::marker {
                    color: var(--accentColor);
                    font-weight: 700;
                }
            }

            :global(ol) {
                margin: 0.2rem 0;
            }
        }

        /* ── Task lists (GFM checkboxes) ── */
        :global(li:has(> input[type='checkbox'])) {
            list-style: none;
            margin-left: -1.25rem;
            display: flex;
            align-items: baseline;
            gap: 0.55rem;

            &::before {
                display: none;
            }

            :global(input[type='checkbox']) {
                flex-shrink: 0;
                accent-color: var(--accentColor);
                width: 0.95rem;
                height: 0.95rem;
                cursor: default;
            }
        }

        /* ── Blockquote ── */
        :global(blockquote) {
            margin: 2rem 0;
            padding: 1rem 1.5rem;
            border-left: 3px solid var(--accentColor);
            background: var(--backgroundDarkColor);
            border-radius: 0 0.5rem 0.5rem 0;

            :global(p) {
                margin: 0;
                font-style: italic;
                opacity: 0.82;
            }

            :global(blockquote) {
                margin: 0.75rem 0 0;
                background: transparent;
            }
        }

        /* ── Inline code ── */
        :global(code) {
            font-family: 'Courier New', monospace;
            font-size: 0.875em;
            background: var(--backgroundDarkColor);
            color: var(--accentColor);
            padding: 0.15em 0.42em;
            border-radius: 0.3rem;
            word-break: break-word;
        }

        /* ── Code blocks ── */
        :global(pre) {
            margin: 1.75rem 0;
            padding: 1.5rem 1.75rem;
            background: var(--foregroundDarkColor);
            border-radius: 0.75rem;
            overflow-x: auto;
            border-left: 3px solid var(--accentColor);

            :global(code) {
                background: none;
                color: var(--backgroundColor);
                padding: 0;
                font-size: 0.875rem;
                line-height: 1.65;
                word-break: normal;
            }
        }

        /* ── Tables ── */
        :global(table) {
            width: 100%;
            border-collapse: collapse;
            margin: 1.75rem 0;
            font-family: var(--urbanistFont);
            font-size: 0.95rem;
            border: 1px solid var(--backgroundDarkColor);
            border-radius: 0.5rem;
            overflow: hidden;
        }

        :global(thead th) {
            background: var(--backgroundDarkColor);
            color: var(--foregroundColor);
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            text-align: left;
            padding: 0.8rem 1rem;
        }

        :global(tbody td) {
            padding: 0.65rem 1rem;
            border-bottom: 1px solid var(--backgroundDarkColor);
            color: var(--foregroundColor);

            :global(code) {
                font-size: 0.82em;
            }
        }

        :global(tbody tr:last-child td) {
            border-bottom: none;
        }

        :global(tbody tr:hover td) {
            background: var(--backgroundDarkColor);
            transition: background 0.15s ease;
        }

        /* ── Images ── */
        :global(img) {
            max-width: 100%;
            height: auto;
            border-radius: 0.75rem;
            display: block;
            margin: 1.5rem auto;
        }

        /* ── Figure / figcaption ── */
        :global(figure) {
            margin: 2rem 0;

            :global(img) {
                margin: 0;
            }

            :global(figcaption) {
                font-family: var(--urbanistFont);
                font-size: 0.85rem;
                color: var(--foregroundColor);
                opacity: 0.55;
                text-align: center;
                margin-top: 0.75rem;
                font-style: italic;
            }
        }

        /* ── Details / Summary (accordion) ── */
        :global(details) {
            margin: 1.25rem 0;
            border: 1px solid var(--backgroundDarkColor);
            border-radius: 0.6rem;
            overflow: hidden;

            :global(summary) {
                padding: 0.85rem 1.25rem;
                font-family: var(--urbanistFont);
                font-weight: 600;
                font-size: 1rem;
                cursor: pointer;
                user-select: none;
                background: var(--backgroundDarkColor);
                color: var(--foregroundColor);
                list-style: none;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                transition:
                    background 0.2s ease,
                    color 0.2s ease;

                &::before {
                    content: '▶';
                    font-size: 0.6rem;
                    color: var(--accentColor);
                    transition: transform 0.25s ease;
                    flex-shrink: 0;
                }

                &::-webkit-details-marker {
                    display: none;
                }

                &:hover {
                    color: var(--accentColor);
                }
            }

            &[open] > :global(summary)::before {
                transform: rotate(90deg);
            }

            > :global(*:not(summary)) {
                padding: 0.25rem 1.25rem;

                &:last-child {
                    padding-bottom: 1.25rem;
                }
            }

            > :global(p:first-of-type) {
                padding-top: 1rem;
            }
        }

        /* ── Description list ── */
        :global(dl) {
            margin: 1.5rem 0;
            font-family: var(--urbanistFont);

            :global(dt) {
                font-weight: 700;
                font-size: 1rem;
                color: var(--foregroundColor);
                margin-top: 1.1rem;

                &:first-child {
                    margin-top: 0;
                }
            }

            :global(dd) {
                margin-left: 1.5rem;
                font-size: 1rem;
                line-height: 1.65;
                color: var(--foregroundColor);
                opacity: 0.75;
            }
        }

        /* ── Progress & Meter ── */
        :global(progress),
        :global(meter) {
            accent-color: var(--accentColor);
        }

        /* ── Fieldset / Legend ── */
        :global(fieldset) {
            border-color: var(--backgroundDarkColor);
            border-radius: 0.5rem;
            font-family: var(--urbanistFont);

            :global(legend) {
                font-weight: 600;
                font-size: 0.9rem;
            }

            :global(label) {
                font-size: 0.95rem;
            }
        }

        /* ── First paragraph lead-in ── */
        > :global(p:first-of-type) {
            font-size: clamp(1.1rem, 2vw, 1.25rem);
            line-height: 1.7;
            font-weight: 300;
            opacity: 0.9;
        }
    }

    /* ────────────────────────────────────────
       Post Bottom Nav
    ──────────────────────────────────────── */
    .post-bottom-nav {
        max-width: 720px;
        margin: 0 auto;
        padding: 1.5rem 2rem 3rem;
        border-top: 1px solid var(--backgroundDarkColor);

        @media (max-width: 800px) {
            padding: 1.25rem 1rem 2.5rem;
        }
    }

    .back-link {
        font-family: var(--urbanistFont);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--foregroundColor);
        text-decoration: none;
        opacity: 0.5;
        transition:
            opacity 0.2s ease,
            color 0.2s ease;

        &:hover {
            opacity: 1;
            color: var(--accentColor);
        }
    }
</style>

