---
interface Props {
    size?: number;
    strokeWidth?: number;
}
const { size = 88, strokeWidth = 3.5 } = Astro.props;
---

<div class="blob-icon" data-blob-icon style={`--blob-size: ${size}px`}>
    <svg
        class="blob-svg"
        viewBox="0 0 100 100"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
    >
        <path
            class="blob-path"
            fill="none"
            stroke="var(--accentColor)"
            stroke-width={strokeWidth}
            stroke-linejoin="round"
        />
    </svg>
    <div class="blob-slot">
        <slot />
    </div>
</div>

<style lang="scss">
    .blob-icon {
        position: relative;
        width: var(--blob-size);
        height: var(--blob-size);
        flex-shrink: 0;

        .blob-svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            overflow: visible;
        }

        .blob-slot {
            position: absolute;
            inset: 16%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    }
</style>

<script>
    import gsap from 'gsap';

    // Exact same config as the photo-frame blob in hero.js
    const CONFIG = {
        points: 5,
        minSpeed: 1.5,
        maxSpeed: 1.5,
        variance: 4,          // units in 100-unit viewBox space
        radiusFactor: 0.44,
        tension: 0.3,
        rotationSpeed: 0.331,
    };

    const CENTER = 50;
    const RADIUS = CENTER * CONFIG.radiusFactor;

    function buildSmoothPath(pts: Array<{ x: number; y: number }>) {
        let d = '';
        const len = pts.length;
        const getPt = (i: number) => pts[(i + len) % len];

        for (let i = 0; i < len; i++) {
            const p0 = getPt(i - 1);
            const p1 = getPt(i);
            const p2 = getPt(i + 1);
            const p3 = getPt(i + 2);

            if (i === 0) d += `M ${p1.x.toFixed(2)} ${p1.y.toFixed(2)} `;

            const cp1 = {
                x: p1.x + (p2.x - p0.x) * CONFIG.tension,
                y: p1.y + (p2.y - p0.y) * CONFIG.tension,
            };
            const cp2 = {
                x: p2.x - (p3.x - p1.x) * CONFIG.tension,
                y: p2.y - (p3.y - p1.y) * CONFIG.tension,
            };

            d += `C ${cp1.x.toFixed(2)} ${cp1.y.toFixed(2)}, ${cp2.x.toFixed(2)} ${cp2.y.toFixed(2)}, ${p2.x.toFixed(2)} ${p2.y.toFixed(2)} `;
        }
        return d + 'Z';
    }

    document.querySelectorAll<HTMLElement>('[data-blob-icon]').forEach((el) => {
        const blobPath = el.querySelector<SVGPathElement>('.blob-path');
        if (!blobPath) return;

        const pts = Array.from({ length: CONFIG.points }, (_, i) => ({
            baseAngle: ((Math.PI * 2) / CONFIG.points) * i,
            speed:
                CONFIG.minSpeed +
                Math.random() * (CONFIG.maxSpeed - CONFIG.minSpeed),
            offset: Math.random() * Math.PI * 2,
        }));

        gsap.ticker.add((time) => {
            const globalRotation = time * CONFIG.rotationSpeed;

            const coords = pts.map((pt) => {
                const r =
                    RADIUS +
                    Math.sin(time * pt.speed + pt.offset) * CONFIG.variance;
                const a = pt.baseAngle + globalRotation;
                return {
                    x: CENTER + Math.cos(a) * r,
                    y: CENTER + Math.sin(a) * r,
                };
            });

            blobPath.setAttribute('d', buildSmoothPath(coords));
        });
    });
</script>
