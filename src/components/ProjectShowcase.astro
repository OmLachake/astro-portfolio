---
export interface Project {
    title: string;
    description: string;
    image: string;
    tags: string[];
    year?: string;
    liveUrl?: string;
    repoUrl?: string;
}

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;
---

<div class="showcase-wrapper">
    <section class="project-showcase">
        {projects.map((project, i) => (
            <div class="showcase-slide" data-index={i}>
                <img src={project.image} alt={project.title} loading="eager" />
                <div class="slide-info">
                    <div class="slide-number">
                        {String(i + 1).padStart(2, '0')}
                        <span class="slide-total">/ {String(projects.length).padStart(2, '0')}</span>
                    </div>
                    <div class="slide-tags">
                        {project.tags.map(tag => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                    <h2 class="slide-title">{project.title}</h2>
                    <p class="slide-desc">{project.description}</p>
                    {(project.liveUrl || project.repoUrl) && (
                        <div class="slide-links">
                            {project.liveUrl && (
                                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="slide-link">Live</a>
                            )}
                            {project.repoUrl && (
                                <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="slide-link">Code</a>
                            )}
                        </div>
                    )}
                </div>
            </div>
        ))}
        <div class="dissolve-grid"></div>
    </section>
</div>

<style lang="scss">
    .showcase-wrapper {
        position: relative;
        width: 100%;
    }

    .project-showcase {
        position: sticky;
        top: 0;
        width: 100%;
        height: 100svh;
        overflow: hidden;
    }

    .showcase-slide {
        position: absolute;
        inset: 0;
        clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
        will-change: clip-path;

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }

    .slide-info {
        position: absolute;
        bottom: 2.5rem;
        left: 2.5rem;
        max-width: 460px;
        background: var(--foregroundColor);
        border-radius: 1rem;
        padding: 1.75rem 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        box-shadow: 0 10px 50px rgba(0, 0, 0, 0.3);

        @media (max-width: 800px) {
            bottom: 1.25rem;
            left: 1rem;
            right: 1rem;
            max-width: unset;
            padding: 1.25rem;
        }
    }

    .slide-number {
        font-family: var(--urbanistFont);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--backgroundColor);
        opacity: 0.45;

        .slide-total {
            opacity: 0.6;
        }
    }

    .slide-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;

        .tag {
            font-family: var(--urbanistFont);
            font-size: 0.68rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--accentColor);
            background: color-mix(in srgb, var(--accentColor) 12%, var(--backgroundColor));
            padding: 0.2rem 0.55rem;
            border-radius: 0.35rem;
        }
    }

    .slide-title {
        font-family: var(--yesevaFont);
        font-size: clamp(1.4rem, 2.5vw, 2rem);
        color: var(--backgroundColor);
        margin: 0;
        line-height: 1.1;
    }

    .slide-desc {
        font-family: var(--urbanistFont);
        font-size: 0.92rem;
        font-weight: 300;
        line-height: 1.65;
        color: var(--backgroundColor);
        opacity: 0.7;
        margin: 0;
    }

    .slide-links {
        display: flex;
        gap: 1rem;
        margin-top: 0.1rem;

        .slide-link {
            font-family: var(--urbanistFont);
            font-size: 0.78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--backgroundColor);
            text-decoration: none;
            border-bottom: 1px solid var(--accentColor);
            padding-bottom: 0.1rem;
            transition: color 0.2s ease;

            &:hover {
                color: var(--accentColor);
            }
        }
    }

    .dissolve-grid {
        position: absolute;
        inset: 0;
        z-index: 100;
        pointer-events: none;
    }
</style>

<script>
    import gsap from 'gsap';

    const wrapper = document.querySelector('.showcase-wrapper');
    const showcase = document.querySelector('.project-showcase');

    if (wrapper && showcase) {
        const CELL_SIZE = 22;
        const spreadAbove = 0.12;
        const spreadBelow = 0.12;
        const scatterIntensity = 0.06;
        const solidCoreRadius = 0.02;
        const minScatterAtCenter = 0.1;
        const visibilityThreshold = 0.35;

        const blobShapes = [
            '50% 50% 50% 50% / 50% 50% 50% 50%',
            '60% 40% 55% 45% / 45% 55% 45% 55%',
            '70% 30% 60% 40% / 40% 60% 50% 50%',
            '40% 60% 40% 60% / 60% 40% 60% 40%',
            '55% 45% 70% 30% / 30% 70% 45% 55%',
            '65% 35% 45% 55% / 55% 45% 35% 65%',
            '45% 55% 65% 35% / 35% 65% 55% 45%',
            '30% 70% 50% 50% / 50% 50% 70% 30%',
        ];

        const slides = showcase.querySelectorAll('.showcase-slide');
        const totalImages = slides.length;
        const totalTransitions = totalImages - 1;
        const dissolveGrid = showcase.querySelector('.dissolve-grid');

        wrapper.style.height = `${totalImages * 100}vh`;

        slides.forEach((slide, i) => {
            slide.style.zIndex = String(totalImages - i);
        });

        function hashFromPos(row, col, seed) {
            const raw = Math.sin(row * seed + col * (seed * 2.45)) * 43758.5453;
            return raw - Math.floor(raw);
        }

        let cells = [];
        let cellEls = [];
        let cellVisRandom = [];
        let cellScatter = [];
        let rows = 0;
        let columns = 0;

        function buildGrid() {
            dissolveGrid.innerHTML = '';
            cells = [];
            cellEls = [];

            columns = Math.ceil(window.innerWidth / CELL_SIZE);
            rows = Math.ceil(window.innerHeight / CELL_SIZE);

            for (let row = 0; row < rows; row++) {
                for (let col = 0; col < columns; col++) {
                    const sizeVariance = 1.0 + hashFromPos(row, col, 53.7) * 0.4;
                    const size = CELL_SIZE * sizeVariance;
                    const offset = (CELL_SIZE - size) / 2;
                    const shapeIndex = Math.floor(hashFromPos(row, col, 31.4) * blobShapes.length);

                    const el = document.createElement('div');
                    const zIndex = Math.floor(hashFromPos(row, col, 89.3) * 8) + 1;
                    const isAlt = hashFromPos(row, col, 173.9) < 0.2;
                    const bgColor = isAlt ? 'var(--accentColorAlt)' : 'var(--accentColor)';

                    el.style.cssText = `
                        position:absolute;
                        left:${col * CELL_SIZE + offset}px;
                        top:${row * CELL_SIZE + offset}px;
                        width:${size}px;
                        height:${size}px;
                        background:${bgColor};
                        border-radius:${blobShapes[shapeIndex]};
                        box-shadow:2px 3px 7px rgba(0,0,0,0.22);
                        z-index:${zIndex};
                        visibility:hidden;
                    `;
                    dissolveGrid.appendChild(el);
                    cellEls.push(el);
                    cells.push({
                        row,
                        col,
                        normalizedY: (row + 0.5) / rows,
                        normalizedX: (col + 0.5) / columns,
                    });
                }
            }

            cellVisRandom = cells.map(c => hashFromPos(c.row, c.col, 127.1));
            cellScatter = cells.map(c =>
                (hashFromPos(c.row, c.col, 269.3) - 0.5) * scatterIntensity
            );
        }

        buildGrid();

        let resizeTimer;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(buildGrid, 200);
        });

        const totalTravelRange = 1 + spreadAbove + spreadBelow;
        let activeTransition = -1;

        function updateClipPaths(progress) {
            for (let i = 0; i < totalTransitions; i++) {
                const segStart = i / totalTransitions;
                const segEnd = (i + 1) / totalTransitions;
                let segProgress = (progress - segStart) / (segEnd - segStart);
                segProgress = gsap.utils.clamp(0, 1, segProgress);
                const remapped = -spreadAbove + segProgress * totalTravelRange;
                const pct = gsap.utils.clamp(0, 100, remapped * 100);
                slides[i].style.clipPath =
                    `polygon(0% ${pct}%, 100% ${pct}%, 100% 100%, 0% 100%)`;
            }
        }

        function updateBlobs(bandCenterY) {
            for (let i = 0; i < cells.length; i++) {
                const rawDist = Math.abs(cells[i].normalizedY - bandCenterY);
                const scatterStrength = gsap.utils.clamp(
                    minScatterAtCenter, 1, rawDist / solidCoreRadius
                );
                const scattered =
                    cells[i].normalizedY - bandCenterY + cellScatter[i] * scatterStrength;
                const normDist =
                    scattered >= 0
                        ? scattered / spreadBelow
                        : Math.abs(scattered) / spreadAbove;

                if (normDist >= 1) {
                    cellEls[i].style.visibility = 'hidden';
                    continue;
                }

                const centeredX = (cells[i].normalizedX - 0.5) * 2;
                const horizontalBell = Math.exp(-2.5 * centeredX * centeredX);
                const lineCoverage = Math.exp(-18 * normDist * normDist);
                const bellBulge = Math.exp(-2.5 * normDist * normDist) * horizontalBell;
                const density = Math.max(lineCoverage, bellBulge);
                cellEls[i].style.visibility =
                    density > cellVisRandom[i] * visibilityThreshold ? 'visible' : 'hidden';
            }
        }

        function hideAll() {
            for (let i = 0; i < cellEls.length; i++) {
                cellEls[i].style.visibility = 'hidden';
            }
        }

        function onScroll() {
            const rect = wrapper.getBoundingClientRect();
            const scrollableHeight = wrapper.offsetHeight - window.innerHeight;
            if (scrollableHeight <= 0) return;

            const progress = gsap.utils.clamp(0, 1, -rect.top / scrollableHeight);
            const raw = progress * totalTransitions;
            const currentTransition = Math.min(Math.floor(raw), totalTransitions - 1);
            const transitionProgress = gsap.utils.clamp(0, 1, raw - currentTransition);

            if (currentTransition !== activeTransition) {
                activeTransition = currentTransition;
            }

            const bandCenterY = -spreadAbove + transitionProgress * totalTravelRange;

            if (transitionProgress <= 0 || transitionProgress >= 1) {
                hideAll();
                updateClipPaths(progress);
                return;
            }

            updateClipPaths(progress);
            updateBlobs(bandCenterY);
        }

        // Hook into the global Lenis instance
        window.lenis.on('scroll', onScroll);
    }
</script>
